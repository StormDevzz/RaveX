#include <windows.h>
#include "resource.h"
101 ICON "kickx.ico"
IDR_ICON_FIELD_NAME PNG "icons/field_name.png"
IDR_ICON_FIELD_VERSION PNG "icons/field_version.png"
IDR_ICON_FIELD_LOADER PNG "icons/field_loader.png"
