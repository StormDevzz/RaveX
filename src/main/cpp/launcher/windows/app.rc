IDR_ICON_MODS PNG "icons/mods.png"
IDR_ICON_PACKAGE PNG "icons/package.png"
IDR_ICON_SERVERS PNG "icons/servers.png"
IDR_ICON_LOGS PNG "icons/logs.png"
IDR_ICON_WIN10 PNG "icons/win10.png"
IDR_ICON_LOADER_VANILLA PNG "icons/loader_vanilla.png"
IDR_ICON_LOADER_FABRIC PNG "icons/loader_fabric.png"
IDR_ICON_LOADER_FORGE PNG "icons/loader_forge.png"
IDR_ICON_LOADER_QUILT PNG "icons/loader_quilt.png"
IDR_ICON_ACCOUNTS PNG "icons/accounts.png"
IDR_ICON_ADD PNG "icons/add.png"
IDR_ICON_EDIT PNG "icons/edit.png"
IDR_ICON_DELETE PNG "icons/delete.png"
IDR_ICON_FOLDER PNG "icons/folder.png"
IDR_ICON_SEARCH PNG "icons/search.png"
IDR_ICON_DOWNLOAD PNG "icons/download.png"
IDR_ICON_PLAY PNG "icons/play.png"
IDR_ICON_SETTINGS PNG "icons/settings.png"
