IDR_ICON_MICROSOFT PNG "icons/microsoft.png"
IDR_ICON_OFFLINE PNG "icons/offline.png"
IDR_ICON_NOTES PNG "icons/notes.png"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RaveX"
            VALUE "FileDescription", "KickX Launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "kickx_launcher"
            VALUE "LegalCopyright", "Copyright (C) RaveX 2026"
            VALUE "OriginalFilename", "kickx_launcher.exe"
            VALUE "ProductName", "KickX Launcher"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
